[Unit]
Description=ASH Password Manager USB-watch agent (spec section 30)
Documentation=man:ash-password-manager(1)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ash-password-manager-agent
Restart=on-failure
RestartSec=5
# Defense in depth only -- this process never holds vault secrets to
# begin with (see packaging/systemd/README.md); these just shrink its
# blast radius as a resident process in general.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/ash-password-manager %h/.local/share/ash-password-manager %h/.local/state/ash-password-manager
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
