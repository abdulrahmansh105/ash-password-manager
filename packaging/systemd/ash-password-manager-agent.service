[Unit]
Description=ASH Password Manager USB-watch agent (spec section 30)
Documentation=man:ash-password-manager(1)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ash-password-manager-agent
Restart=on-failure
RestartSec=5
# Defense in depth only -- this process never holds vault secrets to
# begin with (see packaging/systemd/README.md); these just shrink its
# blast radius as a resident process in general.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/ash-password-manager %h/.local/share/ash-password-manager
# StateDirectory (not a plain ReadWritePaths entry): unlike the two
# paths above, which the app itself has always created lazily on first
# write, nothing ever created ~/.local/state/ash-password-manager --
# ReadWritePaths requires its target to already exist, so this unit
# failed every single start with 226/NAMESPACE ("Failed to set up mount
# namespacing") until this was changed. StateDirectory= is systemd's
# directive for exactly this: for a --user unit it resolves to
# $XDG_STATE_HOME/ash-password-manager (matching core.appdirs.state_home())
# and, critically, creates it itself before the service starts.
StateDirectory=ash-password-manager
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
