[Desktop Entry]
Type=Application
Name=ASH Password Manager
GenericName=Password Manager
Comment=USB-first, device-bound password manager -- no password ever leaves your vault's USB
Exec=ash-password-manager sign-in
Icon=password-manager
Terminal=false
Categories=Utility;Security;
Keywords=password;vault;keepass;totp;security;usb;
StartupNotify=true
StartupWMClass=dev.ash.PasswordManager
